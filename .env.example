# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./atlas.db

# ─── LLM provider ────────────────────────────────────────────────────────────
# Options: mock | openai | anthropic
LLM_PROVIDER=mock

# OpenAI settings (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic settings (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ─── Feature flags ───────────────────────────────────────────────────────────
# Cache repeated /chat responses for CACHE_TTL_SECONDS
ENABLE_RESPONSE_CACHE=true
# Append sanitised prompt excerpts to logs/prompts.log
ENABLE_PROMPT_LOGGING=false
# Enforce tighter payload size limits on /chat (4 000 chars) and /documents (20 000 chars)
STRICT_MODE=false

# ─── Internal admin ──────────────────────────────────────────────────────────
# Required to access /internal/stats and /internal/cache/flush.
# Must be non-empty; /internal/* returns 503 if this is not set.
INTERNAL_ADMIN_TOKEN=change-me-before-deploy

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Cache ───────────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=300

# ─── Chunking & RAG ──────────────────────────────────────────────────────────
CHUNK_SIZE=400
CHUNK_OVERLAP=50
# Chunks older than this are purged by the background cleanup task
CHUNK_TTL_SECONDS=604800
CLEANUP_INTERVAL_SECONDS=3600
RAG_TOP_K=3
EMBEDDING_DIMS=64

# ─── Logging ─────────────────────────────────────────────────────────────────
PROMPT_LOG_PATH=logs/prompts.log
